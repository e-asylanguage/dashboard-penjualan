{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dashboard-penjualan",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // Frontend statis (public/) dilayani langsung oleh lapisan aset Cloudflare (gratis, tidak dihitung request Worker).
  // Hanya /api/* yang menjalankan Worker. Alamat lain yang tidak ada (bot pemindai: /wp-login.php, /.env, …)
  // dijawab 404 oleh lapisan aset tanpa menjalankan Worker, jadi tidak memakan kuota request.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },

  // Rakit public/index.html dari web/index.html + web/views/*.html sebelum dev/deploy.
  "build": { "command": "node scripts/build-html.mjs", "watch_dir": "web" },

  // Jalankan `npm run db:create`, lalu salin database_id dari output ke sini.
  "d1_databases": [
    { "binding": "DB", "database_name": "marketing-dashboard", "database_id": "d5a6e985-77ba-4a2d-be6e-f79b7f2ae04a" }
  ],

  // Sinkron otomatis tiap jam (UTC). 0 * * * * = menit 0 setiap jam.
  "triggers": { "crons": ["0 * * * *"] },

  "vars": {
    "TZ_REPORT": "Asia/Jakarta",
    "META_API_VERSION": "v25.0",
    // TikTok Shop Partner Center › Aplikasi & layanan › ID layanan (bukan rahasia)
    "TIKTOK_SERVICE_ID": "7695607629884098356",
    // Menu Pemakaian Cloudflare (token-nya di secret CF_API_TOKEN)
    "CF_ACCOUNT_ID": "91fec36559aea73749dc77ccebc7ab5a"
  },

  "observability": { "enabled": true }
}
